# ==============================================================================
# A24by7 Backend — Environment Configuration Template
# Copy this file to .env for local development.
# Never commit .env or real production credentials to version control.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Connection Parameters
DB_HOST=localhost
DB_PORT=3306
DB_NAME=a24by7_dev
DB_USER=root
DB_PASSWORD=your_secure_local_password

# Connection Pool Settings
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# CORS Configuration
# Allowed frontend origin(s), comma-separated if multiple.
CORS_ORIGIN=http://localhost:5173